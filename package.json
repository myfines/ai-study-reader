{
  "name": "ai-study-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 127.0.0.1 --port 1420",
    "build": "node scripts/assets.mjs && tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "bundle": "tauri build --bundles nsis",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write src tests *.ts *.json scripts/*.mjs",
    "test:native": "node tests/native-smoke.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  }
}
