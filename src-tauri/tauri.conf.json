{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Study Reader",
  "version": "0.1.0",
  "identifier": "org.aistudy.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Study Reader",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "本地 AI 批注阅读器",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../licenses/": "licenses/",
      "../LICENSE": "LICENSE.txt",
      "../DEPENDENCY-LICENSES.md": "DEPENDENCY-LICENSES.md",
      "../RUST-LICENSES.md": "RUST-LICENSES.md",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    }
  }
}
